# 环境变量配置
# 复制此文件为 .env 并按需修改

# 访问控制：token / anonymous / off
# token：公网部署推荐，写接口需要 ADMIN_TOKEN
# anonymous：个人内网常用，普通写接口免登录
# off：完全关闭普通和高风险管理接口鉴权，仅建议可信内网
AUTH_MODE=anonymous
ADMIN_TOKEN=

# 允许访问内网/本地地址：WebDAV 同步到 NAS 或内网 AI 网关时开启
ALLOW_PRIVATE_NETWORK=false

# MySQL 数据库连接字符串；留空时使用 SQLite
# DATABASE_URL=mysql://user:pass@mysql-host.example.com:3306/bookmarks?ssl-mode=REQUIRED
DATABASE_URL=

# ========================================
# AI（可选）
# ========================================
AI_ENABLED=false
AI_PROVIDER=openai
AI_MODEL=gpt-4o-mini
AI_BASE_URL=https://api.openai.com/v1

# 是否允许前端临时传入 Key、Base URL、Provider 和生成参数
# 自用可选；对外暴露站点不建议开启
AI_CLIENT_OVERRIDES=false

# OpenAI
OPENAI_API_KEY=

# Gemini（Google）
GEMINI_API_KEY=

# Claude（Anthropic）
ANTHROPIC_API_KEY=
ANTHROPIC_VERSION=2023-06-01

# 高级可选项
# AI_TIMEOUT_MS=8000
# AI_SYSTEM_PROMPT=你是一个书签整理助手。输出必须且只能包含两行：tags: ...\\nsummary: ...
# CORS_ORIGIN=https://example.com
