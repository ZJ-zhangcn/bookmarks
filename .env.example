# 环境变量配置
# 复制此文件为 .env 并按需修改

# ========================================
# 端口配置
# ========================================
PORT=3000

# ========================================
# 访问控制
# ========================================
# token：公网部署推荐，写接口需要 ADMIN_TOKEN
# anonymous：个人内网常用，普通写接口免登录
# off：完全关闭鉴权，仅建议可信内网
AUTH_MODE=anonymous
ADMIN_TOKEN=

# 允许访问内网/本地地址（WebDAV 同步到 NAS 时开启）
ALLOW_PRIVATE_NETWORK=false

# ========================================
# AI 功能（可选）
# ========================================
AI_ENABLED=false
AI_MODEL=gpt-4o-mini
AI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=

# 高级可选项
# AI_TIMEOUT_MS=8000
# AI_SYSTEM_PROMPT=你是一个书签整理助手。输出必须且只能包含两行：tags: ...\\nsummary: ...

# ========================================
# CORS（可选）
# ========================================
# CORS_ORIGIN=https://example.com

# ========================================
# SQLite（可选）
# ========================================
# DB_PATH=../data/bookmarks.db
# 数据库升级前自动备份的保留数量（默认 5）
# DB_MIGRATION_BACKUP_LIMIT=5
# 每日启动/巡检时创建经过完整性校验的数据库备份（默认开启）
# DB_DAILY_BACKUP_ENABLED=true
# 每日备份保留数量（默认 14）
# DB_DAILY_BACKUP_LIMIT=14
# 完整恢复前自动备份的保留数量（默认 5）
# DB_RESTORE_BACKUP_LIMIT=5

# 可选：SQLite 异地 WebDAV 备份（服务端执行，不会把密码返回前端）
# DB_OFFSITE_BACKUP_ENABLED=false
# DB_OFFSITE_BACKUP_PROVIDER=webdav
# DB_OFFSITE_WEBDAV_URL=https://dav.example.com/dav/
# DB_OFFSITE_WEBDAV_USERNAME=your-user
# DB_OFFSITE_WEBDAV_PASSWORD=your-app-password
# DB_OFFSITE_WEBDAV_PATH=bookmarks/sqlite-backups/
# DB_OFFSITE_BACKUP_LIMIT=30
