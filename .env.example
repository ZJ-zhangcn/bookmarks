# 环境变量配置
# 复制此文件为 .env 并按需修改

# ========================================
# 端口配置
# ========================================
PORT=3000

# ========================================
# 访问控制
# ========================================
# token：公网部署推荐，写接口需要 ADMIN_TOKEN
# anonymous：个人内网常用，普通写接口免登录
# off：完全关闭鉴权，仅建议可信内网
# session：内置登录，打开网站需登录（会话默认 30 天，活跃访问自动续期）
AUTH_MODE=anonymous
ADMIN_TOKEN=

# AUTH_MODE=session 时使用。请使用随机长字符串作为 AUTH_SESSION_SECRET。
# AUTH_USERNAME=admin
# AUTH_PASSWORD=change-this-password
# AUTH_SESSION_SECRET=replace-with-a-long-random-secret
# AUTH_SESSION_TTL_MS=2592000000
# AUTH_SESSION_IDLE_TTL_MS=604800000
# HTTPS 部署时建议开启；本地 HTTP 请保持 false/不设置
# AUTH_COOKIE_SECURE=true

# 允许访问内网/本地地址（WebDAV 同步到 NAS 时开启）
ALLOW_PRIVATE_NETWORK=false

# ========================================
# AI 功能（可选）
# ========================================
AI_ENABLED=false
AI_MODEL=gpt-4o-mini
AI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=

# 高级可选项
# AI_TIMEOUT_MS=8000
# AI_SYSTEM_PROMPT=你是一个书签整理助手。输出必须且只能包含两行：tags: ...\\nsummary: ...

# ========================================
# CORS（可选）
# ========================================
# CORS_ORIGIN=https://example.com

# ========================================
# SQLite（可选）
# ========================================
# Docker Compose 已固定为 /app/backend/data/bookmarks.db；本地直接运行时可使用下面的路径
# DB_PATH=./data/bookmarks.db
# 数据库升级前自动备份的保留数量（默认 5）
# DB_MIGRATION_BACKUP_LIMIT=5
# 每日启动/巡检时创建经过完整性校验的数据库备份（默认开启）
# DB_DAILY_BACKUP_ENABLED=true
# 每日备份保留数量（默认 14）
# DB_DAILY_BACKUP_LIMIT=14
# 完整恢复前自动备份的保留数量（默认 5）
# DB_RESTORE_BACKUP_LIMIT=5

# 可选：SQLite 异地 WebDAV 备份（服务端执行，不会把密码返回前端）
# DB_OFFSITE_BACKUP_ENABLED=false
# DB_OFFSITE_BACKUP_PROVIDER=webdav
# DB_OFFSITE_WEBDAV_URL=https://dav.example.com/dav/
# DB_OFFSITE_WEBDAV_USERNAME=your-user
# DB_OFFSITE_WEBDAV_PASSWORD=your-app-password
# DB_OFFSITE_WEBDAV_PATH=bookmarks/sqlite-backups/
# DB_OFFSITE_BACKUP_LIMIT=30
