# 环境变量配置
# 复制此文件为 .env 并按需修改

# ========================================
# 端口配置
# ========================================
PORT=3000

# ========================================
# 访问控制
# ========================================
# token：公网部署推荐，写接口需要 ADMIN_TOKEN
# anonymous：个人内网常用，普通写接口免登录
# off：完全关闭鉴权，仅建议可信内网
AUTH_MODE=anonymous
ADMIN_TOKEN=

# 允许访问内网/本地地址（WebDAV 同步到 NAS 时开启）
ALLOW_PRIVATE_NETWORK=false

# ========================================
# AI 功能（可选）
# ========================================
AI_ENABLED=false
AI_MODEL=gpt-4o-mini
AI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=

# 高级可选项
# AI_TIMEOUT_MS=8000
# AI_SYSTEM_PROMPT=你是一个书签整理助手。输出必须且只能包含两行：tags: ...\\nsummary: ...

# ========================================
# CORS（可选）
# ========================================
# CORS_ORIGIN=https://example.com
