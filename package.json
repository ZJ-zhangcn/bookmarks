{
  "name": "bookmark-nav",
  "version": "1.0.0",
  "description": "书签导航 - 支持 Docker 部署",
  "scripts": {
    "dev": "cd backend && node server.js",
    "dev:frontend": "cd frontend && npx vite",
    "build": "echo 'No build step required'",
    "build:frontend": "cd frontend && npx vite build",
    "preview": "cd frontend && npx vite preview",
    "lint": "eslint frontend/modules backend shared",
    "lint:fix": "eslint frontend/modules backend shared --fix",
    "test": "node --test --test-concurrency=1 tests/*.test.js",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "audit:high": "npm audit --audit-level=high"
  },
  "dependencies": {
    "better-sqlite3": "^12.8.0",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "express": "^4.21.2"
  },
  "optionalDependencies": {
    "cheerio": "^1.1.2"
  },
  "devDependencies": {
    "@eslint/js": "^8.57.1",
    "@playwright/test": "^1.55.0",
    "esbuild": "^0.28.1",
    "eslint": "^8.57.1",
    "globals": "^15.15.0",
    "vite": "^8.0.16"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
