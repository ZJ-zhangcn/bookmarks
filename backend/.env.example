# 代理配置（用于访问外网图标服务）
# 如果需要访问 Google Favicon、Favicon.im 等服务，请配置代理
HTTP_PROXY=http://127.0.0.1:7890
HTTPS_PROXY=http://127.0.0.1:7890

# 数据库配置
# 相对路径以 backend/ 目录为基准；Docker Compose 会显式使用持久化卷中的绝对路径
# DB_PATH=./data/bookmarks.db
# 数据库升级前自动备份的保留数量（默认 5）
# DB_MIGRATION_BACKUP_LIMIT=5
# 每日启动/巡检时创建经过完整性校验的数据库备份（默认开启）
# DB_DAILY_BACKUP_ENABLED=true
# 每日备份保留数量（默认 14）
# DB_DAILY_BACKUP_LIMIT=14
# 完整恢复前自动备份的保留数量（默认 5）
# DB_RESTORE_BACKUP_LIMIT=5

# 是否允许访问内网地址
# ALLOW_PRIVATE_NETWORK=false
